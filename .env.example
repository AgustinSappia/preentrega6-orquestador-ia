# Copiá este archivo a ".env" y completá con tu propia API key.
# NUNCA subas el archivo ".env" real (con tu key de verdad) a un
# repositorio -- por eso está en .gitignore.

# Proveedor del LLM: "openai" o "anthropic".
LLM_PROVIDER=openai

# Completá la que corresponda según LLM_PROVIDER.
OPENAI_API_KEY=tu-api-key-de-openai-aca
OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=tu-api-key-de-anthropic-aca
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
